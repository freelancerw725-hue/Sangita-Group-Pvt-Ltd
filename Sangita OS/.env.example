SUPABASE_URL=https://qmftopfxhxzupmnmockb.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
VITE_SUPABASE_URL=https://qmftopfxhxzupmnmockb.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Phase 1 — Keyword Pool
# Secret for n8n → Sangita OS keyword APIs. Generate with: openssl rand -hex 32
KEYWORDS_API_KEY=your_random_keywords_key_here
# Alias accepted: N8N_API_KEY, SANGITA_OS_API_KEY

# Phase 2 — Shared env for local n8n testing (do NOT commit real values)
LEAD_FINDER_BASE_URL=https://sangita-lead-finder.vercel.app
SANGITA_OS_BASE_URL=https://sangita-core.vercel.app

# Phase 5 — Sangita OS Plugins (client-side, public URLs only — no secrets)
# These are exposed to the browser via Vite, so use VITE_ prefix
VITE_LEADS_BASE_URL=https://sangita-lead-finder.vercel.app
VITE_BULK_MAIL_BASE_URL=https://sangita-email-outreach.vercel.app
# Aliases also supported: VITE_LEAD_FINDER_BASE_URL, VITE_LEADS_URL, VITE_BULK_MAIL_URL

# Lovable Gateway (optional for AI keywords)
LOVABLE_API_KEY=
KEYWORD_AI_PROVIDER=stub

# Phase 3 — Keyword Intelligence Engine
# Cron secret for securing the daily automation endpoint. Generate with: openssl rand -hex 32
CRON_SECRET=your_random_cron_secret_here

# Lead Finder integration (for sending daily keywords)
LEAD_FINDER_BASE_URL=https://sangita-lead-finder.vercel.app
LEAD_FINDER_AUTOMATION_KEY=your_lead_finder_automation_key_here
# Alternative names also supported: LEAD_FINDER_API_KEY, AUTOMATION_API_KEY

# Keyword Intelligence Engine defaults (can be overridden in UI)
# KEYWORD_INTELLIGENCE_ROTATION_MODE=sequential
# KEYWORD_INTELLIGENCE_ANALYSIS_WINDOW_DAYS=30
# KEYWORD_INTELLIGENCE_MAX_KEYWORDS_PER_DAY=20
# KEYWORD_INTELLIGENCE_MIN_KEYWORDS_PER_DAY=5
# KEYWORD_INTELLIGENCE_DUPLICATION_AVOIDANCE_DAYS=14
# KEYWORD_INTELLIGENCE_AUTO_GENERATE_KEYWORDS=true
# KEYWORD_INTELLIGENCE_LEAD_FINDER_BATCH_SIZE=10
# KEYWORD_INTELLIGENCE_ENABLE_LEAD_FINDER_INTEGRATION=true
