# ---- SwiftGrowth Outreach CRM - server environment ----
# Copy to .env and adjust. NEVER commit real secrets.

# Application
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000

# Database (SQLite file path, relative to project root)
DB_PATH=server/data/crm.db
DB_VERBOSE=false

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# Phase 4 Step 1 — Batch Import (server-to-server)
# Generate with: openssl rand -hex 32
BULK_MAIL_IMPORT_KEY=your_random_import_key_here
# Aliases: BATCH_IMPORT_KEY, LEAD_FINDER_AUTOMATION_KEY, BULK_MAIL_API_KEY
LEAD_FINDER_BASE_URL=http://localhost:3000
