# Production persistence. Set one of these in Vercel.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# POSTGRES_URL=postgresql://user:password@host:5432/database?sslmode=require

# YouTube Data API v3. Server-side only.
YOUTUBE_API_KEY=your_youtube_api_key

# Google Sheets service account. Server-side only.
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_CLIENT_EMAIL=your_service_account_email@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Gmail OAuth. Use your production Vercel URL in production.
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=https://your-vercel-domain.vercel.app/api/gmail/callback
GMAIL_FROM_ADDRESS=hello@swiftgrowthdigital.com

# Optional Gemini email drafting.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.0

# Phase 2 — Automation (n8n → Lead Finder)
# Separate secret for n8n to call Lead Finder. Generate with: openssl rand -hex 32
LEAD_FINDER_AUTOMATION_KEY=your_random_automation_key_here
# Alias accepted: AUTOMATION_API_KEY, N8N_API_KEY

# Phase 3 — Email Verification (server-only, never expose)
# Mock provider works with no key (deterministic). For real provider:
VERIFICATION_PROVIDER=mock
VERIFICATION_API_KEY=your_verification_api_key_if_using_paid_provider
# Supported: mock, zerobounce, hunter

# Phase 3 — Bulk Mail handoff (read-only)
BULK_MAIL_BASE_URL=http://localhost:3001
LEAD_FINDER_BASE_URL=http://localhost:3000
SANGITA_OS_BASE_URL=http://localhost:5173

# Optional demo automation links.
DEMO_1_LINK=https://drive.google.com/file/d/demo-1-id/view
DEMO_2_LINK=https://drive.google.com/file/d/demo-2-id/view
PORTFOLIO_PDF_LINK=https://drive.google.com/file/d/portfolio-pdf-id/view
