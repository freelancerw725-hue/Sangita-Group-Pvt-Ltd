# Root gitignore for Sangita Group Pvt Ltd monorepo

# Dependencies
**/node_modules/

# Build outputs
**/dist/
**/dist-ssr/
**/.output/
**/.next/
**/out/

# Environment / secrets
**/.env
**/.env.local
**/.env.*.local
**/.dev.vars

# Database files
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm
**/server/data/
**/data/*.json
!**/data/.gitkeep

# Logs
**/logs/
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE / Editor
**/.vscode/*
!**/.vscode/extensions.json
**/.idea/
**/.DS_Store
**/Thumbs.db
**/*.swp
**/*.suo
**/*.ntvs*
**/*.njsproj
**/*.sln

# OS
**/.DS_Store
**/Thumbs.db

# Wrangler / Cloudflare
**/.wrangler/

# Vite / TanStack / Nitro
**/.vinxi/
**/.tanstack/
**/.nitro/

# Test coverage
**/coverage/

# Temporary files
**/*.tmp
**/*.temp