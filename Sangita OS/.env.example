# Phase 1 — Keyword Pool
# Secret for n8n → Sangita OS keyword APIs. Generate with: openssl rand -hex 32
KEYWORDS_API_KEY=your_random_keywords_key_here
# Alias accepted: N8N_API_KEY, SANGITA_OS_API_KEY

# Phase 2 — Shared env for local n8n testing (do NOT commit real values)
LEAD_FINDER_BASE_URL=https://sangita-lead-finder.vercel.app
SANGITA_OS_BASE_URL=https://sangita-core.vercel.app

# Phase 5 — Sangita OS Plugins (client-side, public URLs only — no secrets)
# These are exposed to the browser via Vite, so use VITE_ prefix
VITE_LEADS_BASE_URL=https://sangita-lead-finder.vercel.app
VITE_BULK_MAIL_BASE_URL=https://sangita-email-outreach.vercel.app
# Aliases also supported: VITE_LEAD_FINDER_BASE_URL, VITE_LEADS_URL, VITE_BULK_MAIL_URL

# Lovable Gateway (optional for AI keywords)
LOVABLE_API_KEY=
